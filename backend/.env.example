# Configuração da API do MedQuestResearch (Backend)
# Copie este arquivo para .env e preencha com os valores corretos

# Variáveis de ambiente do backend
# Este arquivo é usado pelo backend Python/FastAPI

# Chaves de API (obrigatórias)
# GROQ_API_KEY=sua-chave-groq-aqui
# GEMINI_API_KEY=sua-chave-gemini-aqui

# Configuração do banco de dados PostgreSQL
# DATABASE_URL=postgresql://usuario:senha@host:porta/database

# CORS - Origens permitidas (separadas por vírgula)
# O backend já inclui automaticamente:
# - https://medquestresearch.up.railway.app
# - http://localhost:3000 (desenvolvimento)
# - http://localhost:3001 (desenvolvimento alternativo)
# 
# Para adicionar URLs adicionais, configure:
# ALLOWED_ORIGINS=https://outra-url.com,https://mais-uma-url.com

# Configurações opcionais
# DEBUG=True
# LOG_LEVEL=INFO
