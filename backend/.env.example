# Configuração da API do MedQuestResearch (Backend)
# Copie este arquivo para .env e preencha com os valores corretos

# Chave OpenRouter (obrigatória para LLM). O cliente usa apenas a API compatível OpenAI em openrouter.ai.
# OPENROUTER_API_KEY=sk-or-v1-...
# Legado aceito: API_OPENAI_KEY_RESEARCH (mesmo valor da chave OpenRouter)

# URL base — OpenRouter (padrão)
# OPENROUTER_API_BASE=https://openrouter.ai/api/v1

# Modelos (IDs OpenRouter, ex.: nvidia/..., openrouter/elephant-alpha)
# OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_FALLBACK=z-ai/glm-4.5-air:free,nvidia/nemotron-nano-9b-v2:free
# Prioridade na lista interna (opcional)
# OPENROUTER_MODEL_PRIMARY=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_MODEL_SECONDARY=openrouter/elephant-alpha
# Legado: OPENAI_MODEL, OPENAI_MODEL_PRIMARY, OPENAI_MODEL_FALLBACK, OPENAI_API_BASE

# PDF / tradução: lista tipo "pdf" em model_router.py começa com openrouter/elephant-alpha

# GROQ_API_KEY=...  (opcional: tradução rápida no pdf_processor quando definida)

# Configuração do banco de dados PostgreSQL
# DATABASE_URL=postgresql://usuario:senha@host:porta/database

# CORS - Origens permitidas (separadas por vírgula)
# O backend já inclui automaticamente:
# - https://medquestresearch.up.railway.app
# - http://localhost:3000 (desenvolvimento)
# - http://localhost:3001 (desenvolvimento alternativo)
#
# Para adicionar URLs adicionais, configure:
# ALLOWED_ORIGINS=https://outra-url.com,https://mais-uma-url.com

# Configurações opcionais
# DEBUG=True
# LOG_LEVEL=INFO
# OPENROUTER_MODEL_COOLDOWN_SECONDS=900

# Custos da etapa de escrita de artigo (Etapa 5)
# CREDIT_COST_ESCREVER_ARTIGO=5
# CREDIT_COST_ESCREVER_ARTIGO_COMPLETO=15
